{
  "name": "@miorin/dsh-atlas-continuity",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Review repository changes and history, and keep workspace notes while the agent works.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "aggregate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5",
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "node ../../tools/dsh-aggregate/src/cli.mts generate .",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; import { execFileSync } from 'node:child_process'; const cli = '../../tools/dsh-aggregate/src/cli.mts'; if (existsSync(cli)) execFileSync(process.execPath, [cli, 'generate', '.'], { stdio: 'inherit' })\" 1>&2",
    "test": "npm run build && npm run check",
    "check": "node ../../tools/dsh-aggregate/src/cli.mts check . && node --test",
    "prepublishOnly": "node ../../tools/dsh-aggregate/src/cli.mts verify-release ."
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "version": 1,
      "runtimeRowId": "dsh-atlas-continuity",
      "plugins": [
        "@miorin/dsh-vcs-panel",
        "@miorin/dsh-sideby-note"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-vcs-panel": "link:../dsh-vcs-panel",
    "@miorin/dsh-sideby-note": "link:../dsh-sideby-note"
  }
}
